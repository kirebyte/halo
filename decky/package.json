  "description": "Halo's Decky plugin: the ROG Xbox Ally joystick rings from the quick access menu",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirebyte/halo.git"
  },
  "keywords": ["decky", "plugin", "rog-ally", "rgb", "lighting"],
  "author": "Kira <kira@kitsuneando.com>",
  "license": "GPL-2.0-only",
  "homepage": "https://github.com/kirebyte/halo#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
